# SQLite database (relative to prisma/ directory)
DATABASE_URL="file:./dev.db"

# Admin panel credentials
ADMIN_USERNAME="admin"
# Generate: npm run admin:hash -- "your-strong-password"
# Important: escape every $ as \$ so Next.js does not expand the bcrypt hash
ADMIN_PASSWORD_HASH="\$2b\$12\$replace_with_generated_hash"

# 32+ chars. Generate: openssl rand -base64 48
SESSION_SECRET=""

# Generate: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=""

# Optional: comma-separated IP allowlist for /admin
# ADMIN_ALLOWED_IPS="127.0.0.1,::1"

# Optional: shared secret required for POST /api/v1/accounts/register
# CLIENT_REGISTRATION_SECRET=""

# APP_URL="https://datapulse.example.com"
NODE_ENV="development"
